# Copy this file to .env.local and fill in your Supabase project values
# (Project Settings -> API in your Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is SECRET — server-side only, used by /admin actions
# to bypass RLS (set dollar rate, approve TOP payments, verify shops).
# Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple shared password for the /admin page (swap for real auth later)
ADMIN_PASSWORD=juba2025

NEXT_PUBLIC_MOMO_NUMBER=0926058145
NEXT_PUBLIC_MOMO_NAME=Steven
